/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/site.css
  Cache-Control: public, max-age=0, must-revalidate

/site.js
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=86400

/models/*
  Content-Type: model/gltf-binary
  Cache-Control: public, max-age=86400
